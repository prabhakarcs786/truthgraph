{
  "name": "path-1-release-desk",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "sanity:dev": "sanity dev",
    "sanity:deploy": "sanity deploy",
    "sanity:schema": "sanity schema deploy",
    "seed": "node --env-file=.env.local --import tsx scripts/seed.ts",
    "export:kb": "node --import tsx scripts/export-kb.ts",
    "check:live": "node --env-file-if-exists=.env.local --import tsx scripts/check-live.ts",
    "doctor": "node --env-file-if-exists=.env.local --import tsx scripts/doctor.ts",
    "setup:live": "bash scripts/setup-live.sh"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "overrides": {
    "adm-zip": "0.6.1",
    "smol-toml": "1.9.0",
    "@module-federation/dts-plugin": {
      "undici": "7.30.0"
    },
    "@vercel/frameworks": {
      "js-yaml": "3.15.2"
    },
    "typeid-js": {
      "uuid": "11.1.1"
    }
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.130",
    "@ai-sdk/mcp": "^1.0.89",
    "@ai-sdk/openai": "^3.0.121",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@sanity/client": "^8.9.0",
    "ai": "^6.0.297",
    "lucide-react": "^1.49.0",
    "next": "16.3.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanity": "^6.17.0",
    "semver": "^7.8.5",
    "server-only": "^0.0.1",
    "styled-components": "^6.5.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.3.8",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/semver": "^7.8.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
